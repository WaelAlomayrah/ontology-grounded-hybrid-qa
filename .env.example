# Development defaults only. Change all credentials before any shared deployment.
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ADMIN_TOKEN=change-me-development-only

FUSEKI_BASE_URL=http://fuseki:3030
FUSEKI_DATASET=ontology
FUSEKI_USER=admin
FUSEKI_PASSWORD=change-me-fuseki

MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=ontology_documents
MILVUS_VECTOR_DIMENSION=1024
MILVUS_METRIC_TYPE=COSINE

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=120

EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
EMBEDDING_NORMALIZE=true

DATASET_PATH=/app/data/KG2QA_ontology_dataset
ONTOLOGY_FILE=/app/data/sample/ontology.ttl
VECTOR_TOP_K=8
GRAPH_RESULT_LIMIT=100
HYBRID_VECTOR_WEIGHT=0.55
HYBRID_GRAPH_WEIGHT=0.45
MAX_CONTEXT_ITEMS=30
MAX_CONTEXT_CHARACTERS=12000
ENABLE_LLM_QUERY_PLANNER=false
ENABLE_SAMPLE_FALLBACK=true
MAX_QUESTION_LENGTH=1000

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

FUSEKI_HOST_PORT=3030
MILVUS_HOST_PORT=19530
ATTU_HOST_PORT=8001
OLLAMA_HOST_PORT=11434
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
CADVISOR_HOST_PORT=8080
