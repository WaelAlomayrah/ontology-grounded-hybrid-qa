  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0001> .

<http://example.org/arabic-enterprise/document/DOC-01501> a ae:Document ;
  rdfs:label "إجراء إدارة البيانات رقم 1501"@ar ;
  ae:documentType "إجراء"@ar ;
  ae:body "يوثق هذا المستند أعمال إدارة البيانات المتعلقة بـ مشروع التحول السحابي 12. يتناول المستند استخدام منصة ذكاء الأعمال المؤسسية 120، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند منى الدوسري ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
