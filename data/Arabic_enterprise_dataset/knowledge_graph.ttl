  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0061> .

<http://example.org/arabic-enterprise/document/DOC-00061> a ae:Document ;
  rdfs:label "إجراء السلامة رقم 61"@ar ;
  ae:documentType "إجراء"@ar ;
  ae:body "يوثق هذا المستند أعمال السلامة المتعلقة بـ مشروع التحول السحابي 72. يتناول المستند استخدام منصة ذكاء الأعمال المؤسسية 160، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند منى الدوسري ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
