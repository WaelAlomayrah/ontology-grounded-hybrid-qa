<http://example.org/arabic-enterprise/document/DOC-00029> a ae:Document ;
  rdfs:label "تقييم مخاطر المشتريات رقم 29"@ar ;
  ae:documentType "تقييم مخاطر"@ar ;
  ae:body "يوثق هذا المستند أعمال المشتريات المتعلقة بـ مشروع الابتكار المفتوح 20. يتناول المستند استخدام بوابة التدريب المؤسسية 152، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند وليد المالكي ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-30" ;
