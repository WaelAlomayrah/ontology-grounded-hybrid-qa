<http://example.org/arabic-enterprise/document/DOC-00024> a ae:Document ;
  rdfs:label "دليل مستخدم التسويق رقم 24"@ar ;
  ae:documentType "دليل مستخدم"@ar ;
  ae:body "يوثق هذا المستند أعمال التسويق المتعلقة بـ مشروع الأتمتة الذكية 65. يتناول المستند استخدام بوابة الجودة المؤسسية 57، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند لينا العمري ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-25" ;
  ae:classification "عام"@ar ;
  ae:belongsTo <http://example.org/arabic-enterprise/department/DEP-019> ;
  ae:authoredBy <http://example.org/arabic-enterprise/employee/EMP-0409> ;
  ae:aboutSystem <http://example.org/arabic-enterprise/system/SYS-0057> ;
  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0065> .

<http://example.org/arabic-enterprise/document/DOC-00025> a ae:Document ;
  rdfs:label "مذكرة الصيانة رقم 25"@ar ;
  ae:documentType "مذكرة"@ar ;
  ae:body "يوثق هذا المستند أعمال الصيانة المتعلقة بـ مشروع إدارة المواهب 76. يتناول المستند استخدام نظام المراسلات المؤسسية 76، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند ريم الزهراني ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-26" ;
  ae:classification "داخلي"@ar ;
  ae:belongsTo <http://example.org/arabic-enterprise/department/DEP-026> ;
  ae:authoredBy <http://example.org/arabic-enterprise/employee/EMP-0426> ;
  ae:aboutSystem <http://example.org/arabic-enterprise/system/SYS-0076> ;
  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0076> .

<http://example.org/arabic-enterprise/document/DOC-00026> a ae:Document ;
  rdfs:label "خطة عمل التدريب والتطوير رقم 26"@ar ;
  ae:documentType "خطة عمل"@ar ;
  ae:body "يوثق هذا المستند أعمال التدريب والتطوير المتعلقة بـ مشروع تعزيز الأمن السيبراني 87. يتناول المستند استخدام منصة إدارة الهوية المؤسسية 95، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند سارة القحطاني ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-27" ;
  ae:classification "مقيد"@ar ;
  ae:belongsTo <http://example.org/arabic-enterprise/department/DEP-033> ;
  ae:authoredBy <http://example.org/arabic-enterprise/employee/EMP-0443> ;
  ae:aboutSystem <http://example.org/arabic-enterprise/system/SYS-0095> ;
  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0087> .

<http://example.org/arabic-enterprise/document/DOC-00027> a ae:Document ;
  rdfs:label "دراسة البنية التحتية رقم 27"@ar ;
  ae:documentType "دراسة"@ar ;
  ae:body "يوثق هذا المستند أعمال البنية التحتية المتعلقة بـ مشروع الامتثال المؤسسي 98. يتناول المستند استخدام مستودع الأمن السيبراني المؤسسية 114، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند نورة التميمي ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-28" ;
  ae:classification "عام"@ar ;
  ae:belongsTo <http://example.org/arabic-enterprise/department/DEP-040> ;
  ae:authoredBy <http://example.org/arabic-enterprise/employee/EMP-0460> ;
  ae:aboutSystem <http://example.org/arabic-enterprise/system/SYS-0114> ;
  ae:aboutProject <http://example.org/arabic-enterprise/project/PRJ-0098> .

<http://example.org/arabic-enterprise/document/DOC-00028> a ae:Document ;
  rdfs:label "طلب تغيير الشراكات رقم 28"@ar ;
  ae:documentType "طلب تغيير"@ar ;
  ae:body "يوثق هذا المستند أعمال الشراكات المتعلقة بـ مشروع تحسين جودة البيانات 9. يتناول المستند استخدام تطبيق الحوكمة المؤسسية 133، والمسؤوليات التشغيلية، وضوابط الجودة، ومؤشرات الأداء، وخطة المتابعة الدورية. أعد المستند مازن الرشيدي ويجب مراجعته وفق دورة الاعتماد المؤسسية مع توثيق الملاحظات والإجراءات التصحيحية."@ar ;
  ae:createdAt "2024-01-29" ;
  ae:classification "داخلي"@ar ;
